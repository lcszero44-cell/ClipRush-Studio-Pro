# ===============================
data/client_secrets.json
data/youtube_token.json
*.env
*.env.local
*.env.*.local
*secret*.json
*token*.json
*credentials*.json
google-credentials.json
youtube-oauth2.json

# ===============================
# Ambiente Virtual e Cache Python
# ===============================
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
.pyre/

# ===============================
# Arquivos de Mídia, Renders e Temporários
# ===============================
saida/
data/uploads/
data/temp/
data/thumbs/
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.ts
*.m4v
*.wav
*.mp3
*.flac
*.aac
*.ogg

